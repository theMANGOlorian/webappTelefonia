# =========================
# FASE 1: BUILD (Maven + Java)
# =========================
FROM maven:3.9.6-eclipse-temurin-21 AS backend_compiler

# imposta la directory di lavoro corrente dentro il container
WORKDIR /demo/

# Copia tutto il progetto
COPY . /demo/

# Build del progetto Spring Boot
RUN mvn clean package 


# =========================
# FASE 2: RUNTIME (solo Java)
# =========================
FROM eclipse-temurin:21-jdk

WORKDIR /backend_binary/

# Copia il jar generato dalla fase precedente
COPY --from=backend_compiler /demo/target/*.jar app.jar

# Espone la porta (Spring Boot default spesso 8080)
EXPOSE 8080

# Avvio applicazione
# java -jar target/gs-rest-service-0.0.1-SNAPSHOT.jar
CMD ["java", "-jar", "app.jar"]