# ===== STAGE 1: BUILD ANGULAR =====
FROM node:24.15.0 AS frontend-compiler

WORKDIR /app

# Copia package.json e installa dipendenze
COPY webui/package*.json ./
RUN npm install

# Copia tutto il progetto
COPY ./webui ./webui

# Cambio directory di lavoro in webui
WORKDIR /app/webui

# Build produzione Angular
RUN npm run build --prod


# ===== STAGE 2: NGINX SERVER =====
FROM nginx:alpine

# Copia build Angular dentro nginx
COPY --from=frontend-compiler /app/webui/dist/webapp-angular/browser /usr/share/nginx/html

# Espone porta 80
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
